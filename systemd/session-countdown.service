[Unit]
Description=SessionCountdown server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SessionCountdown
ExecStart=/home/pi/SessionCountdown/scripts/start_pi.sh
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
